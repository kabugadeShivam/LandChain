# ============================================================
# LandChain - Git Ignore
# ============================================================

# -------------------------
# Python
# -------------------------
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Python tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# -------------------------
# Environment / Secrets
# -------------------------
.env
.env.*
!.env.example

# Private keys / credentials
*.pem
*.key
*.p12
*.pfx
secrets.json
credentials.json

# -------------------------
# Node.js
# -------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -------------------------
# Frontend build output
# -------------------------
frontend/dist/
frontend/build/
frontend/.vite/

# -------------------------
# Hardhat / Blockchain
# -------------------------
blockchain/cache/
blockchain/artifacts/
blockchain/typechain/
blockchain/typechain-types/

# Hardhat deployment/build output
cache/
artifacts/

# -------------------------
# Local databases
# -------------------------
*.db
*.sqlite
*.sqlite3

# -------------------------
# Logs
# -------------------------
*.log
logs/

# -------------------------
# OS files
# -------------------------
.DS_Store
Thumbs.db
desktop.ini

# -------------------------
# IDE / Editor
# -------------------------
.vscode/
.idea/
*.swp
*.swo

# -------------------------
# Temporary files
# -------------------------
*.tmp
*.temp
*.bak